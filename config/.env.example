# Robin Agent — Configuration
# Copy this file to .env and fill in your API keys

# ====================
# Social Media
# ====================
# Agent-Reach (free tier available)
AGENT_REACH_API_KEY=your_agent_reach_key_here

# ====================
# SEO & Analytics
# ====================
# DataForSEO (free trial: $5 credit)
DATAFORSEO_USERNAME=your_dataforseo_username
DATAFORSEO_PASSWORD=your_dataforseo_password

# Firecrawl (free tier: 1,000 credits)
FIRECRAWL_API_KEY=your_firecrawl_key_here

# ====================
# Web Scraping
# ====================
# ScrapingBee (free tier: 1,000 requests)
SCRAPINGBEE_API_KEY=your_scrapingbee_key_here

# ====================
# App Integrations
# ====================
# Composio (free tier available)
COMPOSIO_API_KEY=your_composio_key_here

# ====================
# Cloud Browsers
# ====================
# Browserbase (free tier: 100 hours)
BROWSERBASE_API_KEY=your_browserbase_key_here
BROWSERBASE_PROJECT_ID=your_project_id_here

# ====================
# AI Search
# ====================
# Exa (free tier: 1,000 searches)
EXA_API_KEY=your_exa_key_here

# ====================
# Google APIs (optional)
# ====================
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ====================
# Other Services
# ====================
# Ahrefs (paid)
AHREFS_API_KEY=your_ahrefs_key_here

# Semrush (paid)
SEMRUSH_API_KEY=your_semrush_key_here
